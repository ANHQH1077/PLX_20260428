            <xsd:annotation>
              <xsd:documentation>Additional Oil and Gas Quantity</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="ADQNTP" minOccurs="0" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
