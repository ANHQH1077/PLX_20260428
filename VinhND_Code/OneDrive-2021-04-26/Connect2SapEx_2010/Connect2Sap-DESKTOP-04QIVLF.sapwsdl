              <xsd:annotation>
                <xsd:documentation>Structure Dischard Point</xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element name="item" minOccurs="0" maxOccurs="unbounded" type="s0:ZBAPI_STR_DISCHARD_2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" />
