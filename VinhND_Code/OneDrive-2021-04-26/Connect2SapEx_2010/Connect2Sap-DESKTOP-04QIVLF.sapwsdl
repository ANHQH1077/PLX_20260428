              <xsd:annotation>
                <xsd:documentation>Structure Vendor</xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element name="item" minOccurs="0" maxOccurs="unbounded" type="s0:ZBAPI_STR_VENDOR" xmlns:xsd="http://www.w3.org/2001/XMLSchema" />
                </xsd:sequence>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="RETURN" minOccurs="0" type="s0:BAPIRET2" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
