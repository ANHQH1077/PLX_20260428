                  <xsd:maxLength value="4" />
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element name="I_DATE" type="s0:date" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
              <xsd:annotation>
                <xsd:documentation>Document Date in Document</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="I_FLAG">
              <xsd:annotation>
                <xsd:documentation>Data element for status</xsd:documentation>
              </xsd:annotation>
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="1" />
